      "workspaces": {
        "packages/shared": "@crate-digger/shared; zod schemas/sorting; exports ./src/index.ts and ./sorting; scripts: typecheck only",
        "apps/api": "@crate-digger/api; Fastify 5, better-sqlite3, drizzle-orm (+drizzle-kit, migrations in apps/api/drizzle), sharp, zod type provider; src/{routes,services,plugins,db}; scripts: dev, start, typecheck, test, db:*",
        "apps/web": "@crate-digger/web; Vue 3, Pinia, vue-router, Vite 6; scripts: dev, build, preview, typecheck (vue-tsc), test"
      },
      "build_system": "Only apps/web has a build (vite build -> apps/web/dist). API and shared have no build.",
      "docker_ci": {
        "Dockerfile": "multi-stage node:22-bookworm-slim; builds web, prod deps for api, runtime runs node apps/api/src/server.ts as user node, /data volume, healthcheck /api/health",
        "compose.yaml": "app + caddy (docker/Caddyfile) for HTTPS",
        "ci": ".github/workflows/ci.yml: job check (npm ci, format:check, lint, typecheck, test, build); job docker (image build + smoke test of /api/health)"
      },
      "other": "ESLint 9 flat config (eslint.config.js, vue+ts), Prettier (.prettierrc.json), tsconfig.base.json; docs/ (SPEC, DEPLOY, 3 ADRs); .env.example"
    },
    "tests": {
      "runner": "vitest ^3.2 in apps/api (node env, no config file, 9 files in apps/api/test) and apps/web (happy-dom via vite.config.ts, 13 colocated *.test.ts files, uses @vue/test-utils); packages/shared has no tests and no test script",
      "commands_from_repo_root": {
        "install": "npm ci",
        "typecheck": "npm run typecheck   (tsc --noEmit in shared and api, vue-tsc --noEmit in web)",
        "lint": "npm run lint   (eslint .)",
        "format_check": "npm run format:check   (prettier --check .)",
        "test": "npm test   (vitest run in api and web)",
        "test_single_workspace": "npm test -w apps/api   |   npm test -w apps/web",
        "build": "npm run build   (web only)"
      }
