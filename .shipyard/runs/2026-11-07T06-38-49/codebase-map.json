    "structure": {
      "type": "npm workspaces monorepo (package-lock.json at root), ESM ('type: module')",
      "language": "TypeScript (strict, erasableSyntaxOnly; API runs .ts directly via Node native type stripping, no API build step), Vue 3 SFCs in web",
