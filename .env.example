# Copy to .env (which git ignores) and fill in. Used by compose.yaml.

# The password for "Staff log in". Without it the deployment refuses to start.
# Use something long and random, e.g. the output of:  openssl rand -base64 24
ADMIN_PASSWORD=

# Your domain, pointed at this server with a DNS A record. Caddy gets HTTPS for it.
# For trying it on your own machine, leave the default: http://localhost
DOMAIN=http://localhost

# Optional. Sessions are signed with a key derived from ADMIN_PASSWORD, so changing the
# password logs everyone out. Set this (e.g. openssl rand -hex 32) to decouple them.
SESSION_SECRET=
