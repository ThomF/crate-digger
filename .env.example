# Copy to .env (which git ignores) and fill in. Used by compose.yaml.

# The first admin account. On the first start with no admin yet, the app creates an admin
# with this email and password. Both are required; Compose refuses to start without them.
# Changing ADMIN_PASSWORD later does NOT change an existing admin's password.
# Use a long, random password (at least 8 characters), e.g. the output of:  openssl rand -base64 24
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Your domain, pointed at this server with a DNS A record. Caddy gets HTTPS for it.
# For trying it on your own machine, leave the default: http://localhost
DOMAIN=http://localhost

# No longer used: sessions are now random tokens stored (hashed) in the database.
# Safe to leave empty or delete from an existing .env.
SESSION_SECRET=
